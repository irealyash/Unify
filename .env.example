# ─────────────────────────────────────────────────────────────
# Mutual — Environment Variables
# Copy to .env.local and fill in real values. Never commit secrets.
# ─────────────────────────────────────────────────────────────

# Clerk (https://dashboard.clerk.com → API Keys)
# Configure Google as the ONLY social provider. Disable email/password.
# IMPORTANT: CLERK_SECRET_KEY must be the FULL key (usually 50+ chars).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Neon PostgreSQL (https://console.neon.tech → Connection string)
# Enable pgvector: CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_DIMENSIONS=768

# Ably realtime (https://ably.com/dashboard → API Keys)
ABLY_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# UBC verification — comma-separated educational email domains
UBC_VERIFIED_EMAIL_DOMAINS=student.ubc.ca

# Discovery
DISCOVERY_PAGE_SIZE=20
