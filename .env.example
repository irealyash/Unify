# ─────────────────────────────────────────────────────────────
# Unify: copy to .env and fill in. Never commit real secrets.
# The game server reads this file in dev (npm run dev).
# Vite also loads VITE_* keys from this file (envDir = repo root).
# ─────────────────────────────────────────────────────────────

# Game server
PORT=3001
# Comma-separated list of web origins allowed to connect (production)
WEB_ORIGIN=http://localhost:5173

# Phase 2+: Postgres with pgvector (Tiger Data)
DATABASE_URL=

# Phase 2+: Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Auth0 (Google social connection). Application type: Single Page Application.
# In the Auth0 dashboard set:
#   Allowed Callback URLs:     http://localhost:5173
#   Allowed Logout URLs:       http://localhost:5173
#   Allowed Web Origins:       http://localhost:5173
#   Allowed Origins (CORS):    http://localhost:5173
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# Exposed to the Vite web app (same Auth0 app as above)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=

# Web app (production only): URL of the deployed game server.
# In dev, Vite proxies /socket.io and /api to localhost:3001 so this can stay empty.
VITE_SERVER_URL=
