{
  "name": "unify",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w @unify/server\" \"npm run dev -w @unify/web\"",
    "dev:server": "npm run dev -w @unify/server",
    "dev:web": "npm run dev -w @unify/web",
    "build": "npm run build -w @unify/web",
    "start": "npm run start -w @unify/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:setup": "npm run db:setup -w @unify/server"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2"
  }
}
